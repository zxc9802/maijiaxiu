generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model BuyerShowHistory {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  userSnapshot   Json      @map("user_snapshot")
  title          String
  productName    String?   @map("product_name")
  category       String?
  productInfo    Json      @map("product_info")
  generationSets Json      @map("generation_sets")
  results        Json
  status         String    @default("checking")
  schemaVersion  Int       @default(1) @map("schema_version")
  expiresAt      DateTime  @map("expires_at")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([userId, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@index([deletedAt])
  @@map("buyer_show_histories")
}

model BuyerShowGenerationJob {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  userSnapshot Json      @map("user_snapshot")
  historyId    String?   @map("history_id")
  request      Json
  status       String    @default("queued")
  progress     Int       @default(0)
  productInfo  Json?     @map("product_info")
  results      Json?
  error        String?
  historyError String?   @map("history_error")
  startedAt    DateTime? @map("started_at")
  finishedAt   DateTime? @map("finished_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@map("buyer_show_generation_jobs")
}
