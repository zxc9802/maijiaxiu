DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/buyer_show

# Main-site SSO
MAIN_APP_URL=https://www.qycm.top
MAIN_APP_BUYER_SHOW_ENTRY_PATH=/bot/buyer-show
MAIN_APP_BUYER_SHOW_SSO_EXCHANGE_PATH=/api/buyer-show-sso/exchange
REQUIRE_MAIN_APP_SSO=true
BUYER_SHOW_SESSION_SECRET=change-me-to-a-long-random-string
BUYER_SHOW_SESSION_COOKIE_NAME=buyer_show_session
BUYER_SHOW_SESSION_TTL_MINUTES=720

# Text provider
SHANBAOB_BASE_URL=https://www.shanbaob.net/v1
SHANBAOB_API_KEY=
BUYER_SHOW_TEXT_MODEL=gemini-3.1-pro-preview

# Image provider
YUNWU_IMAGE_BASE_URL=https://yunwu.ai/v1
YUNWU_IMAGE_API_KEY=
YUNWU_IMAGE_MODEL=gpt-image-2-all
YUNWU_IMAGE_SIZE=1152x2048

# Final image fallback after Yunwu and XAI each exhaust three retries
FAL_KEY=
FAL_IMAGE_MODEL=openai/gpt-image-2.5/sunburst/edit

# Cloudflare R2 temporary product-reference uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=buyer-show-temp
R2_UPLOAD_PREFIX=tmp/buyer-show
